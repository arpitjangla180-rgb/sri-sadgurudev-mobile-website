/* =====================================================
 UDHAR TABLE
===================================================== */

function renderUdhar(){

const table=
document.getElementById("udharTable");


if(!udhars.length){

table.innerHTML=
`
<tr>
<td colspan="7" style="text-align:center">
अभी कोई Udhar नहीं है।
</td>
</tr>
`;

return;

}


table.innerHTML=
udhars.map(x=>{

const total=
Number(x.amount||0);

const paid=
Number(x.paid||0);

const remaining=
total-paid;


return`

<tr>

<td>
<b>${esc(x.customerName)}</b>
</td>

<td>${esc(x.item||"—")}</td>

<td>${esc(x.date||"—")}</td>

<td>₹${total}</td>

<td>₹${paid}</td>

<td>

<span class="${
remaining>0
?"badge"
:"badgeGreen"
}">

₹${remaining}

</span>

</td>

<td>

<div class="actions">

${
remaining>0
?
`
<button
class="success"
onclick="addPayment('${x.id}')">
💵 Payment
</button>

<button
class="primary"
onclick="whatsappReminder('${x.id}')">
📱 WhatsApp
</button>
`
:
`
<span class="badgeGreen">
Paid
</span>
`
}

</div>

</td>

</tr>

`;

}).join("");

}


