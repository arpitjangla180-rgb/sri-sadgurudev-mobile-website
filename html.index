/* =====================================================
 IMAGE PREVIEW
===================================================== */

window.previewImage=function(event){

const file=
event.target.files?.[0];

const image=
document.getElementById("preview");


if(!file){

image.style.display="none";
return;

}


image.src=
URL.createObjectURL(file);

image.style.display="block";

};


/* =====================================================
 FILE BASE64
===================================================== */

function fileToPart(file){

return new Promise(
(resolve,reject)=>{

const reader=
new FileReader();

reader.onload=()=>{

const result=
String(reader.result);

resolve({

inlineData:{

data:
result.split(",")[1],

mimeType:
file.type

}

});

};

reader.onerror=reject;

reader.readAsDataURL(file);

});

}


/* =====================================================
 GEMINI AI
===================================================== */

window.analyzeImage=async function(){

const file=
document.getElementById("aiImage")
.files?.[0];

const message=
document.getElementById("aiMessage");

const result=
document.getElementById("aiResult");

const button=
document.getElementById("aiButton");


if(!file){

message.className="message error";
message.classList.remove("hidden");

message.innerText=
"पहले Product की photo चुनें।";

return;

}


button.disabled=true;

button.innerText=
"🤖 AI पहचान रहा है...";

message.className="message";
message.classList.remove("hidden");

message.innerText=
"Product photo analyze हो रही है...";

result.classList.add("hidden");


try{

const imagePart=
await fileToPart(file);


const prompt=`

आप मोबाइल एक्सेसरीज दुकान के inventory assistant हैं।

इस product image को analyze करें।

केवल valid JSON में उत्तर दें।

Format:

{
"brand":"",
"productName":"",
"category":"",
"title":"",
"description":"",
"keywords":[]
}

अगर brand स्पष्ट नहीं है तो Unknown लिखें।

Product की जानकारी का अनुमान लगाते समय
अत्यधिक certainty न दिखाएं।

`;


const response=
await model.generateContent([

prompt,

imagePart

]);


const text=
response.response.text();


const clean=
text
.replace(/```json/gi,"")
.replace(/```/g,"")
.trim();


let data;


try{

data=
JSON.parse(clean);

}catch{

data={

brand:"Unknown",

productName:"Unknown",

category:"Other",

title:"AI Suggestion",

description:text,

keywords:[]

};

}


window.aiData=data;


result.classList.remove("hidden");


result.innerHTML=

`

<h3>🤖 AI Result</h3>

<p>
<b>Brand:</b>
${esc(data.brand||"Unknown")}
</p>

<p>
<b>Product Name:</b>
${esc(data.productName||"")}
</p>

<p>
<b>Category:</b>
${esc(data.category||"")}
</p>

<p>
<b>Title:</b>
${esc(data.title||"")}
</p>

<p>
<b>Description:</b>
${esc(data.description||"")}
</p>

<p>
<b>Keywords:</b>
${Array.isArray(data.keywords)
?data.keywords.map(esc).join(", ")
:""}
</p>

<button
class="primary"
onclick="useAIData()">
📦 Product Form में डालें
</button>

`;


message.className="message ok";

message.innerText=
"AI analysis complete ✅";


}catch(error){

console.error(error);

message.className=
"message error";

message.innerText=
"Gemini AI Error:\n"+
error.message+
"\n\nअगर App Check error आ रहा है तो Firebase App Check setup पूरा करें।";

}finally{

button.disabled=false;

button.innerText=
"🤖 AI से Product पहचानें";

}

};


/* =====================================================
 USE AI DATA
===================================================== */

window.useAIData=function(){

const data=
window.aiData;

if(!data)return;


document.getElementById("productName")
.value=data.productName||"";


document.getElementById("productBrand")
.value=data.brand||"";


const category=
String(data.category||"");


const select=
document.getElementById("productCategory");


const option=
[...select.options]
.find(x=>
x.value.toLowerCase()
===category.toLowerCase()
);


if(option)
select.value=option.value;


openSection("products");


alert(
"AI information Product form में डाल दी गई है।\n\n"+
"Price और Quantity भरकर Product Save करें।"
);

};


/* =====================================================
 ESCAPE HTML
===================================================== */

function esc(value){

return String(value??"")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}

</script>

</body>
</html>
